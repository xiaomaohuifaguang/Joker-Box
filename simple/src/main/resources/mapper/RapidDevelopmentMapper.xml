<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cat.simple.rapiddev.mapper.RapidDevelopmentMapper">
    <select id="queryAllFields" resultType="com.cat.common.entity.rapidDevelopment.FieldInfo">
        SHOW FULL COLUMNS FROM  ${tableName};
    </select>
    <select id="getBaseTableInfo" resultType="com.cat.common.entity.rapidDevelopment.TableInfo">
        SELECT TABLE_NAME  AS tableName,
               TABLE_COMMENT AS tableComment
        FROM information_schema.TABLES
        WHERE TABLE_SCHEMA = DATABASE()      -- ← 自动取当前库
          AND TABLE_NAME = #{tableName};
    </select>
</mapper>